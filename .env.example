# 复制为 .env 并填入真 key：
#   cp .env.example .env
# .env 已被 .gitignore，不会被提交。

# SiliconFlow（硅基流动）— triage 默认 profile 使用
# https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# Kimi (Moonshot) — deepdive 默认 profile 使用
# https://platform.kimi.com 控制台
MOONSHOT_API_KEY=

